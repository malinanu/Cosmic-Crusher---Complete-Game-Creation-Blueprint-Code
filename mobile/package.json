{
  "name": "cosmic-crusher-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Android and iOS apps for Cosmic Crusher (Capacitor wrapper around the web build).",
  "scripts": {
    "build:web": "python3 ../tools/build.py mobile",
    "sync": "npm run build:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
